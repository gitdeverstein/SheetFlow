{
  "name": "sheetflow-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm run dev -w @sheetflow/backend\" \"npm run dev -w @sheetflow/frontend\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p apps/backend/tsconfig.json && tsc --noEmit -p apps/frontend/tsconfig.app.json",
    "lint": "npm run lint -w @sheetflow/backend && npm run lint -w @sheetflow/frontend",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "migrate": "npm run db:push -w @sheetflow/db",
    "seed": "npm run db:seed -w @sheetflow/db",
    "test": "npm run test -w @sheetflow/backend && npm run test -w @sheetflow/frontend",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "concurrently": "^10.0.3",
    "prettier": "^3.8.4"
  }
}
